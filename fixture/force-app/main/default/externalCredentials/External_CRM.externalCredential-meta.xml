<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>External CRM (ERP) OAuth client credentials</label>
    <authenticationProtocol>Oauth</authenticationProtocol>
    <description>Client credentials with a client secret against the ERP token endpoint. The client id and secret are populated in the org after deployment, never in source. The protocol variant value for this flow is declared, not verified from a reference page (ADR-005).</description>
    <externalCredentialParameters>
        <parameterName>AuthProviderUrl</parameterName>
        <parameterType>AuthProviderUrl</parameterType>
        <parameterValue>https://erp.example/oauth/token</parameterValue>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterName>Scope</parameterName>
        <parameterType>AuthParameter</parameterType>
        <parameterValue>sync.read sync.write</parameterValue>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterName>SyncBridge</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
</ExternalCredential>
